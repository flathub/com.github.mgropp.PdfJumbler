{
    "id": "com.github.mgropp.PdfJumbler",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.openjdk21"
    ],
    "command": "pdfjumbler",
    "rename-icon": "pdfjumbler",
    "finish-args": [
        "--env=PATH=/app/jre/bin:/app/bin:/usr/bin",
        "--env=JAVA_HOME=/app/jre",
        "--env=JAVA=/app/jre/bin/java",
        "--share=ipc",
        "--socket=x11",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=home",
        "--persist=.java"
    ],
    "modules": [
        {
            "name": "xgetres",
            "buildsystem": "simple",
            "build-commands": [
                "make",
                "make install PREFIX=/app"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/tamirzb/xgetres",
                    "tag": "1.0",
                    "commit": "7dd6aa2e3a469382ba09152710a5bb4abb3fbc9c"
                }
            ]
        },
        {
            "name": "pdfjumbler",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/openjdk21/install.sh",
                "install -d /app/pdfjumbler/",
                "mv pdfjumbler.jar /app/pdfjumbler/",
                "install -Dm755 pdfjumbler.sh /app/bin/pdfjumbler"
            ],
            "post-install": [
                "install -Dm644 ${FLATPAK_ID}.desktop -t /app/share/applications/",
                "install -Dm644 ${FLATPAK_ID}.metainfo.xml -t /app/share/metainfo/",
                "install -Dm644 pdfjumbler.svg -t /app/share/icons/hicolor/scalable/apps/"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://github.com/mgropp/pdfjumbler/releases/download/v-0.5.1/pdfjumbler.jar",
                    "sha256": "c4416f0ae8b4294d22dc047effca80510b6c4159e03ca017178bc0ae3f73f749"
                },
                {
                    "type": "file",
                    "path": "com.github.mgropp.PdfJumbler.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "com.github.mgropp.PdfJumbler.desktop"
                },
                {
                    "type": "file",
                    "path": "pdfjumbler.sh"
                },
                {
                    "type": "file",
                    "path": "pdfjumbler.svg"
                }
            ]
        }
    ]
}
